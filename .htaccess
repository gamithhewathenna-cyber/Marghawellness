# ===============================================================
# MĀRGHĀ Wellness — Apache configuration (cPanel)
# ===============================================================

# No folder listings; index.php is the home page
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # If the site lives in a sub-folder, set it here, e.g. RewriteBase /margha/
    RewriteBase /

    # --- Force HTTPS: uncomment once the SSL certificate (AutoSSL) is active ---
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Hide anything that must never be public (answers "404 Not Found") ---
    # Hidden files and folders: .git, .env, .user.ini, .htaccess … (but keep .well-known for SSL)
    RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]
    # Internal code, configuration and database folders
    RewriteRule ^(config|includes|partials|database|admin/_inc)(/|$) - [R=404,L,NC]
    # Database exports, backups, logs, archives, docs and deployment files anywhere
    RewriteRule \.(sql|sqlite3?|db|dump|bak|backup|old|orig|save|swp|log|ini|env|sh|md|yml|yaml|lock|dist|example|zip|tar|gz|tgz|bz2|rar|7z)$ - [R=404,L,NC]
    RewriteRule (^|/)(error_log|composer\.(json|lock)|package(-lock)?\.json)$ - [R=404,L,NC]

    # --- Clean URLs: /journeys → page.php?slug=journeys ---
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([A-Za-z0-9-]+)/?$ page.php?slug=$1 [L,QSA]
</IfModule>

# Second line of defence (also works if mod_rewrite is unavailable)
<FilesMatch "(^\.|\.(sql|sqlite3?|db|dump|bak|backup|old|orig|save|swp|log|ini|env|sh|md|yml|yaml|lock|dist|zip|tar|gz|tgz|bz2|rar|7z)$|^error_log$|^secrets.*\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Don't advertise server software / PHP version
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # --- Uncomment once HTTPS works everywhere (tells browsers to always use HTTPS) ---
    # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
ServerSignature Off

# Browser caching for static files
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
