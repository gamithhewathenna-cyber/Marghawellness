# Files in the repository that must NOT be copied to public_html (used by .cpanel.yml / rsync).
# Paths starting with / are relative to the repository root.

# Git + deployment metadata
.git/
.gitignore
.gitattributes
.github/
/.cpanel.yml
/.deployignore

# Database files — the live database is managed manually in phpMyAdmin
/database/
*.sql
*.sql.gz
*.dump
*.sqlite
*.db

# Secrets and templates (real secrets live in /home/<account>/margha-secrets.php)
/config/secrets.local.php
/config/secrets.example.php
.env
.env.*

# Documentation and editor files
*.md
.vscode/
.idea/

# Never ship backups, logs or archives
*.bak
*.backup
*.log
*.zip
*.tar
*.gz
