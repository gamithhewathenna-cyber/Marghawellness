# ---------------------------------------------------------------
# MĀRGHĀ Wellness — files that must never reach GitHub
# ---------------------------------------------------------------

# Secrets / credentials (real values live outside the web root on cPanel)
config/secrets.local.php
config/*.local.php
margha-secrets.php
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
auth.json
.htpasswd
id_rsa*
*.kdbx

# Database exports, dumps and backups
# (database/schema.sql and database/admin.sql are table definitions only — no data — and stay tracked)
*.sql
!database/schema.sql
!database/admin.sql
*.sql.gz
*.sql.zip
*.sql.bz2
*.dump
*.sqlite
*.sqlite3
*.db
*.bak
*.backup
*.old
*.orig
backup/
backups/
db-backups/
*-backup.*
*_backup.*

# Archives (site zips, cPanel backups)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Logs and runtime files
*.log
error_log
logs/
tmp/
cache/

# Images uploaded through the admin live only on the server
assets/images/uploads/*
!assets/images/uploads/.htaccess

# Editor / OS clutter
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
node_modules/
vendor/
